{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/generated-scripting.schema.json",
  "title": "Generated OpenTS scripting catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["trigger_actions", "trigger_action_orphan_texts", "trigger_events", "team_missions"],
  "properties": {
    "trigger_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "trigger_action_orphan_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table_index", "name", "description"],
        "properties": {
          "table_index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "trigger_events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "team_missions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mission" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "line"],
      "properties": {
        "section": { "enum": ["[Actions]", "[Events]"] },
        "line": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "common": {
      "type": "object",
      "required": ["id", "kind", "index", "editor_name", "editor_description", "need", "parameters", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "kind": { "enum": ["trigger-action", "trigger-event", "team-mission"] },
        "index": { "type": "integer", "minimum": 0 },
        "editor_name": { "type": ["string", "null"] },
        "editor_description": { "type": ["string", "null"] },
        "need": { "type": "string", "pattern": "^NEED_[A-Z0-9_]+$" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "status": { "enum": ["generated", "needs_label", "needs_review", "verified-mapping"] }
      }
    },
    "action": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "index", "editor_name", "editor_description", "need", "parameters", "status", "attaches_to", "ini_example"],
          "properties": {
            "id": true, "kind": { "const": "trigger-action" }, "index": true,
            "editor_name": true, "editor_description": true, "need": true,
            "parameters": true, "status": true,
            "attaches_to": { "type": ["string", "null"] },
            "ini_example": { "$ref": "#/$defs/example" }
          }
        }
      ]
    },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "index", "editor_name", "editor_description", "need", "parameters", "status", "attaches_to", "ini_example"],
          "properties": {
            "id": true, "kind": { "const": "trigger-event" }, "index": true,
            "editor_name": true, "editor_description": true, "need": true,
            "parameters": true, "status": true,
            "attaches_to": { "type": ["string", "null"] },
            "ini_example": { "$ref": "#/$defs/example" }
          }
        }
      ]
    },
    "mission": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "index", "editor_name", "editor_description", "need", "parameters", "status"],
          "properties": {
            "id": true, "kind": { "const": "team-mission" }, "index": true,
            "editor_name": true, "editor_description": true, "need": true,
            "parameters": true, "status": true
          }
        }
      ]
    }
  }
}
