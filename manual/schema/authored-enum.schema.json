{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/authored-enum.schema.json",
  "title": "Authored enum frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["enum_id", "slug", "title", "summary", "representation", "bindings", "source_files", "values"],
  "properties": {
    "enum_id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "representation": { "enum": ["integer", "token"] },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_value_types", "scripting_parameter_types"],
      "properties": {
        "key_value_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "scripting_parameter_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^code/[^/].*" }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constant", "value", "input", "meaning"],
        "properties": {
          "constant": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "value": { "type": "integer" },
          "input": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
