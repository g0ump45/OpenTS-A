{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/authored-using.schema.json",
  "title": "Authored Using OpenTS frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "category", "source_files"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": { "enum": ["getting-started", "configuration", "compatibility-migration", "troubleshooting"] },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:README\\.md|CONTRIBUTING\\.md|CMakeLists\\.txt|docs/[^/].*|code/[^/].*|Run/[^/].*)$"
      }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["key", "action", "event", "mission", "format", "enum", "system", "command", "guide", "using", "internal"] },
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "not": { "const": "key" } } } },
          "then": { "not": { "required": ["scope"] } }
        }
      ]
    }
  }
}
