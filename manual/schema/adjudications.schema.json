{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/adjudications.schema.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "minProperties": 1,
    "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*::(?:[A-Za-z_][A-Za-z0-9_]*|None)$" },
    "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": { "const": "distinct" },
        "absorbs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*::(?:[A-Za-z_][A-Za-z0-9_]*|None)$" }
        },
        "specializes": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*::(?:[A-Za-z_][A-Za-z0-9_]*|None)$"
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
