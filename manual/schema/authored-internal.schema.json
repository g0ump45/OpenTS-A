{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opents.example/manual/authored-internal.schema.json",
  "title": "Authored engine-internals frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "category", "source_files"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["architecture", "simulation-systems", "data-scripting", "rendering-media", "networking-persistence"]
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^code/[^/].*" }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["key", "action", "event", "mission", "format", "enum", "system", "command", "guide", "using", "internal"] },
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "not": { "const": "key" } } } },
          "then": { "not": { "required": ["scope"] } }
        }
      ]
    }
  }
}
