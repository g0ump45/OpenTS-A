---
const { entry } = Astro.locals.starlightRoute;
const isSystemDetail = entry.id.startsWith('systems/') && entry.id !== 'systems';
---

<h1 id="_top">{entry.data.title}</h1>
{isSystemDetail && entry.data.description && (
	<p class="ots-page-subtitle">{entry.data.description}</p>
)}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.ots-page-subtitle {
			max-width: 62ch;
			margin: 0.4rem 0 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
			line-height: 1.5;
		}
	}
</style>
