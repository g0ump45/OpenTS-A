---
import { Icon } from '@astrojs/starlight/components';

interface Item {
	label: string;
	href: string;
	code?: boolean;
}

interface Props {
	items: Item[];
}

const { items }: Props = Astro.props;
---

<ul class="ots-compact-index not-content" data-compact-index>
	{items.map((item) => (
		<li>
			<a href={item.href}>
				{item.code ? <code>{item.label}</code> : <span>{item.label}</span>}
				<Icon name="right-arrow" size="1rem" />
			</a>
		</li>
	))}
</ul>

<style>
	@layer starlight.components {
		.ots-compact-index {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
			gap: 0.35rem 1rem;
			margin: 0.75rem 0 1.75rem;
			padding: 0;
			list-style: none;
		}

		.ots-compact-index a {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			min-height: 2.4rem;
			border-bottom: 1px solid var(--sl-color-hairline-light);
			padding: 0.4rem 0.25rem;
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.ots-compact-index a:hover,
		.ots-compact-index a:focus-visible {
			color: var(--sl-color-white);
			border-color: var(--sl-color-text-accent);
		}

		.ots-compact-index :global(svg) {
			flex: 0 0 auto;
			color: var(--sl-color-gray-3);
		}
	}
</style>
