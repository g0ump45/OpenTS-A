---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CommandIndex from '../../../components/CommandIndex.astro';
import Feedback from '../../../components/Feedback.astro';
import { UI } from '../../../i18n/en.mjs';
import { allCommands } from '../../../lib/commands';

const records = allCommands().filter((record) => record.kind === 'fixed');
---

<StarlightPage frontmatter={{ title: 'Fixed controls', description: 'OpenTS controls with hardcoded keys that KEYBOARD.INI cannot rebind.', tableOfContents: false }}>
	<Breadcrumb crumbs={[
		{ label: UI.navigation.commands, href: '/commands/' },
		{ label: UI.navigation.fixedControls },
	]} />
	<p class="ots-lede">Controls with hardcoded keys that <code>KEYBOARD.INI</code> cannot rebind.</p>
	<CommandIndex
		records={records}
		noun="controls"
		subjectHeader="Control"
		audiences={['player', 'debug']}
		invocationHeader="Binding"
		searchPlaceholder="Control, key, description…"
	/>
	<Feedback title="Fixed controls" path="/commands/fixed-controls/" />
</StarlightPage>
